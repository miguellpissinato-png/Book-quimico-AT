# Copie este arquivo para ".env" e preencha para ativar o registro compartilhado
# de ocorrências (Supabase, plano gratuito). Sem estas variáveis, os registros
# ficam salvos apenas no celular de quem registrou.
VITE_SUPABASE_URL=https://SEU-PROJETO.supabase.co
VITE_SUPABASE_ANON_KEY=sua-chave-publica-anon
